# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── AI Provider (opsional) ───────────────────────────────────
# Semua key di bawah ini OPSIONAL. Pengguna juga bisa menempel API key
# sendiri lewat tombol ⚙️ "Model" di navbar (disimpan di localStorage browser).
# Server hanya memakai key ENV bila request tidak membawa key dari browser.
# Jangan tempel placeholder seperti "your_..." — nilai placeholder diabaikan.

# 1) OpenAI (default)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# 2) OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://your-site.com   # dikirim sebagai header HTTP-Referer
# OPENROUTER_SITE_NAME=PRD-Genius          # dikirim sebagai header X-Title

# 3) ModelRouter — https://modelrouter.ai
MODELROUTER_API_KEY=
# MODELROUTER_BASE_URL=https://api.modelrouter.ai/v1

# 4) Endpoint OpenAI-compatible kustom (Ollama, Groq, Together, vLLM, LM Studio, dll.)
CUSTOM_API_KEY=
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_MODEL=llama-3.3-70b-instruct

